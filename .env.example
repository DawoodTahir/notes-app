# ─────────────────────────────────────────────────────────────
# YouTube Notes — configuration
# Copy this file to `.env` and fill in the values you need.
# ─────────────────────────────────────────────────────────────

# Which LLM provider to use by default: "anthropic" or "openai".
# You can also override this per-request from the UI.
NOTE_PROVIDER=anthropic

# Anthropic (Claude) — only needed if you use the anthropic provider
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to a sensible current model)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI — only needed if you use the openai provider
OPENAI_API_KEY=
# Optional: override the model
OPENAI_MODEL=gpt-4o

# Optional: point the "openai" provider at any OpenAI-compatible endpoint.
# Leave blank for OpenAI itself. Examples of free options:
#   Groq      OPENAI_BASE_URL=https://api.groq.com/openai/v1
#             OPENAI_MODEL=moonshotai/kimi-k2-instruct
#   OpenRouter OPENAI_BASE_URL=https://openrouter.ai/api/v1
#             OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Gemini    OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#             OPENAI_MODEL=gemini-2.0-flash
#   Ollama    OPENAI_BASE_URL=http://127.0.0.1:11434/v1   (local, no key needed)
#             OPENAI_MODEL=llama3.2:3b
OPENAI_BASE_URL=

# Speech-to-text — used when a video has no caption track (the norm for
# Instagram, Facebook and TikTok). Uses the OpenAI-compatible endpoint above,
# so a free Groq key covers it. Set SPEECH_TO_TEXT=off to disable the fallback.
SPEECH_MODEL=whisper-large-v3-turbo
SPEECH_TO_TEXT=on

# Logged-in access for gated sites. Instagram, Facebook, TikTok and Vimeo
# often refuse anonymous downloads; point yt-dlp at your browser session.
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_FILE=/path/to/cookies.txt

# ── Instagram / Facebook video API ───────────────────────────
# Those sites block anonymous downloads, so links are resolved through a
# third-party API that runs its own proxies — which keeps your own Meta
# account out of the deployment. Only PUBLIC posts are reachable this way.
#   Get a token at https://console.apify.com/account/integrations
VIDEO_API_PROVIDER=apify
APIFY_TOKEN=
# Optional actor overrides:
# APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
# APIFY_FACEBOOK_ACTOR=apify~facebook-posts-scraper
# APIFY_YOUTUBE_ACTOR=pintostudio~youtube-transcript-scraper
#
# Routing: auto = yt-dlp first, API only where it is blocked (default)
#          api  = force every link through the API
#          ytdlp= never use the API
VIDEO_RESOLVER=auto

# Server
HOST=127.0.0.1
PORT=8000

# Sign-in gate. Off by default (personal app on localhost).
# Set to 1 before exposing this on a public URL, or anyone with the
# address can spend your Apify and Groq credits.
REQUIRE_AUTH=0

# First account registered with this address becomes admin (invite-only signup).
ADMIN_EMAIL=
# Set to 1 when served over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=

# ── Deployment limits ────────────────────────────────────────
# Daily per-user caps on the endpoints that spend money. 0 disables a cap.
LIMIT_NOTES=
LIMIT_RESEARCH=
LIMIT_TRANSCRIPT=
LIMIT_REFILE=

# Largest media file to download before transcribing (bytes). Default 150 MB.
MAX_SOURCE_BYTES=

# ── Speech-to-text provider (optional) ───────────────────────
# Defaults to the OPENAI_* settings above. Set these only when the note
# provider has no Whisper endpoint — Gemini, for example — so audio
# transcription can stay on a provider that does.
SPEECH_BASE_URL=
SPEECH_API_KEY=

# How much transcript goes into one request, in characters. Above this the
# text is condensed in chunks first — which costs several times more, since
# every chunk spends its own output allowance. Keep it as large as the
# provider's context and per-minute limit allow.
#   Groq free tier   12000   (8k tokens/min forces chunking)
#   Gemini Flash     200000  (one pass for almost any video)
NOTE_CHAR_BUDGET=

# The position the library is kept from. The classifier treats this as the
# baseline and files each note by whoever it answers — so a folder is the
# tradition or claim being engaged, not the owner's own position. Leave
# empty to file by plain academic subject instead.
# Quote it — run.sh sources this file as shell, so an unquoted value with
# spaces is executed rather than assigned.
#   e.g. NOTES_STANDPOINT="a Muslim preparing to discuss and defend Islam"
NOTES_STANDPOINT=
